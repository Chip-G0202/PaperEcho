# PaperEcho common configuration and secrets
# Optional selector for the unified machine-local JSON configuration.
PAPERECHO_CONFIG=
ZOTERO_PROJECT_ROOT=
# Optional journal-quality API secret. Keep the value local.
EASYSCHOLAR_SECRET_KEY=
# Stage5 recipient compatibility variables. Prefer common.email.recipient in JSON.
PAPERFLOW_REPORT_TO=
NOTIFICATION_EMAIL=

# PaperEcho LLM secrets and compatibility overrides
LLM_MODE=
TITLE_TRANSLATION_API_KEY=
PREFERENCE_LEARNING_API_KEY=
TITLE_TRANSLATION_CONFIG_PATH=
PREFERENCE_LEARNING_CONFIG_PATH=

# PaperEcho Stage5 SMTP
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=
SMTP_SECURE=
SMTP_FROM=

# PaperEcho Zotero Desktop compatibility
# The Desktop path launcher fixes mode/backend; these remain for direct-entry compatibility.
ZOTERO_BACKEND=
ZOTERO_EXE=
ZOTERO_DESKTOP_CLI_TOOL=
ZOTERO_CLI_TOOL=
ZOTERO_EXTERNAL_LAUNCHER=
ZOTERO_CLI_WRITEBACK_BATCH_SIZE=
WORKFLOW_STARTUP_ZOTERO_BACKEND_RETRIES=
WORKFLOW_STARTUP_ZOTERO_BACKEND_INTERVAL_MS=
WORKFLOW_STARTUP_ZOTERO_POST_START_DELAY_MS=

# PaperEcho Zotero Web API
# ZOTERO_API_KEY is a Web-only secret and must have write access to the selected library.
ZOTERO_API_KEY=
ZOTERO_USER_ID=
# Test/development override only; production uses https://api.zotero.org.
ZOTERO_API_BASE=
ZOTERO_WEB_API_REQUEST_CONCURRENCY=

# PaperEcho Standalone Local
# Local input, outputRoot, and feedback belong in paperecho.config.json or CLI arguments.
# Local has no path-specific secret or environment variable.

# PaperEcho cleanup compatibility
PAPERFLOW_CLEANUP_ENABLED=
PAPERFLOW_RETENTION_DAYS=
