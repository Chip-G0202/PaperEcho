{
  "schemaVersion": 2,
  "mode": null,
  "profile": "standard",
  "common": {
    "projectRoot": "..",
    "journalQualityApiKeyEnv": "EASYSCHOLAR_SECRET_KEY",
    "llm": {
      "enabled": true,
      "mode": null,
      "requireRealModel": false,
      "preferenceApiKeyEnv": "PREFERENCE_LEARNING_API_KEY",
      "translationApiKeyEnv": "TITLE_TRANSLATION_API_KEY",
      "preferenceConfig": "preference_learning.config.json",
      "translationConfig": "title_translation.config.json"
    },
    "email": {
      "enabled": false,
      "recipient": null,
      "smtp": {
        "host": null,
        "user": null,
        "passwordEnv": "SMTP_PASS",
        "port": 465,
        "secure": true,
        "from": null
      }
    },
    "cleanup": {
      "enabled": true,
      "retentionDays": 30
    },
    "sourceState": {
      "root": "../review_results/source_state"
    },
    "notifications": {
      "failure": {
        "enabled": false
      },
      "health": {
        "enabled": false,
        "consecutiveThreshold": 2
      },
      "receiptStore": {
        "root": "../review_results/notification_receipts",
        "retryFailed": true,
        "unknownPolicy": "hold"
      }
    },
    "radar": {
      "enabled": false
    },
    "integrity": {
      "enabled": false,
      "bootstrapBatchSize": 50,
      "crossrefConcurrency": 2,
      "pubmedBatchSize": 180,
      "cacheTtlDays": 7
    }
  },
  "desktop": {
    "enabled": false,
    "zoteroExe": null,
    "cliTool": "zotero-cli",
    "writebackBatchSize": 50,
    "startupRetries": 45,
    "startupIntervalMs": 1000,
    "postStartDelayMs": 5000
  },
  "web": {
    "enabled": false,
    "apiKeyEnv": "ZOTERO_API_KEY",
    "userId": null,
    "requestConcurrency": 4
  },
  "local": {
    "enabled": false,
    "input": null,
    "outputRoot": null,
    "feedback": null
  }
}
